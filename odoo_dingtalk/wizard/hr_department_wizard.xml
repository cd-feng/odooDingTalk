<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_dingtalk_department_synchronous_form" model="ir.ui.view">
        <field name="name">微信部门同步</field>
        <field name="model">dingtalk.department.synchronous.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    <p>系统将从钉钉中的同步<strong>部门数据</strong>至系统中，请等待系统同步完成！</p>
                </div>
                <group>
                    <field name="company_id" options="{'no_create': True, 'no_open': True}" />
                </group>
                <footer>
                    <button string="立即同步" name="on_synchronous" type="object" class="oe_highlight"/>
                    <button string="取消" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="dingtalk_department_synchronous_action" model="ir.actions.act_window">
        <field name="name">微信部门同步</field>
        <field name="res_model">dingtalk.department.synchronous.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem name="部门数据同步" id="dingtalk_department_synchronous_menu" parent="dingtalk_sync_menu" sequence="1" action="dingtalk_department_synchronous_action"/>

</odoo>